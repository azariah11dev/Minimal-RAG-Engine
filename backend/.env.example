# -------------------------------------
# Postgres Configuration
# -------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=MiniRAGDB

# -------------------------------------
# Application Database URL
# -------------------------------------
# IMPORTANT:
# The hostname must be "postgres" because that's the Docker service name.
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password_here@postgres:5432/MiniRAGDB

# -------------------------------------
# QDrant Database URL
# -------------------------------------
QDRANT_URL=http://qdrant:6333